# ============================================================
# ADORAXE – Comprehensive .gitignore
# ============================================================

# --- Environment & Secrets (NEVER commit) ---
.env
.env.local
.env.*.local
.env.production
.env.staging
*.env
!.env.example
secrets/
credentials/
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
private_key*
service_account*.json

# --- API Keys & Tokens ---
*_token.txt
*_secret.txt
*access_token*
*refresh_token*
oauth_tokens/
instagram_tokens/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyc
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.ruff_cache/
pyrightconfig.json

# --- Virtual Environments ---
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
backend/venv/
backend/.venv/

# --- Node.js / SvelteKit ---
node_modules/
frontend/node_modules/
.svelte-kit/
frontend/.svelte-kit/
build/
frontend/build/
.vercel
.netlify
frontend/dist/

# --- Package locks (keep package-lock or yarn.lock but not both) ---
# yarn.lock  # uncomment if using npm
# package-lock.json  # uncomment if using yarn

# --- Database ---
*.db
*.sqlite
*.sqlite3
*.sql
local_dumps/
database_dumps/
*.dump
*.backup
pgdata/

# --- Video & Media Files ---
videos/
downloads/
temp_videos/
processed_videos/
uploads/
media/
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.wmv
*.m4v
backend/uploads/
backend/temp/
backend/media/

# --- Logs ---
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS Specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# --- IDE ---
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/

# --- Alembic ---
# Keep alembic.ini and migrations/ tracked
# But not local override configs

# --- Docker ---
# Keep docker-compose.yml tracked
# But not local overrides
docker-compose.override.yml
.docker/

# --- Cloudinary & Storage ---
cloudinary_cache/
cdn_cache/

# --- Testing ---
.pytest_cache/
test-results/
coverage/

# --- Misc ---
*.bak
*.tmp
*.temp
.cache/
.local/
