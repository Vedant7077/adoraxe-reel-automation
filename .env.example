# ============================================================
# ADORAXE – Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# --- Application ---
SECRET_KEY=your-very-long-random-secret-key-here-min-32-chars
DEMO_MODE=true

# --- Database ---
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/adoraxe_db

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Meta / Instagram API ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8000/api/v1/instagram/callback
META_API_VERSION=v21.0

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Security ---
# Encryption key for Instagram tokens (must be 32 url-safe base64 chars)
TOKEN_ENCRYPTION_KEY=your-fernet-encryption-key-here

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
