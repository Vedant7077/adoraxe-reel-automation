# ==============================================================================
# ADORAXE REEL AUTOMATION – ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` in the repository root and fill in your actual values.
# NEVER commit the `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Settings
# ------------------------------------------------------------------------------
# Application name and environment
APP_NAME="Adoraxe"
APP_VERSION="1.0.0"
DEBUG=false

# DEMO_MODE:
#   true  = Safe demo/testing mode. Mock YouTube data is returned, FFmpeg runs
#          locally, and Instagram publishing simulates execution without posting
#          live content to Meta.
#   false = Production mode. Requires valid Meta credentials and Cloudinary setup.
DEMO_MODE=true

# YouTube metadata provider:
#   "demo"   = Uses verified internal mock data (no network or scraping required).
#   "http"   = Native non-browser HTTP scraper for public YouTube channel metadata.
#   "yt_dlp" = Uses yt-dlp metadata extraction.
YOUTUBE_PROVIDER=demo

# Application secret key for session signing and internal CSRF protection (min 32 chars)
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars-long

# Single-Owner Administrator Authentication:
#   AUTH_ENABLED:
#     false = Local development mode (permits unauthenticated local development).
#     true  = Production mode (Render / Vercel public deployment). Enforces X-Admin-Key on all APIs.
#   ADMIN_API_KEY:
#     High-entropy secret key (min 16 chars, 32+ recommended). If AUTH_ENABLED=true and
#     ADMIN_API_KEY is missing or too short, backend startup aborts immediately (fail-closed).
#   DEV_AUTH_BYPASS:
#     Set true only for explicit unauthenticated local testing when AUTH_ENABLED is true.
AUTH_ENABLED=false
ADMIN_API_KEY=replace-with-a-secure-random-admin-key-min-32-chars
DEV_AUTH_BYPASS=false

# Symmetric encryption key for Instagram OAuth tokens (Fernet 32 url-safe base64 chars).
# Generate in python with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-generated-32-url-safe-base64-fernet-key

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# SQLAlchemy PostgreSQL connection URL (psycopg2 driver).
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Default local Docker configuration uses the shortly-postgres container:
DATABASE_URL=postgresql+psycopg2://adoraxe_user:adoraxe_pass_2026@localhost:5432/adoraxe_db

# ------------------------------------------------------------------------------
# 3. Service URLs & CORS
# ------------------------------------------------------------------------------
# Web application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Frontend Vite build environment variable (points client API calls to backend)
VITE_BACKEND_URL=http://localhost:8000

# Comma-separated list of allowed origins for FastAPI CORS middleware
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 4. Meta / Instagram Graph API (Unified Login / Facebook Login for Business)
# ------------------------------------------------------------------------------
# Your Meta App ID and App Secret from developers.facebook.com
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Facebook Login for Business Configuration ID (created under Meta App Dashboard ->
# Use cases -> Facebook Login for Business -> Configurations).
META_CONFIG_ID=your_facebook_login_for_business_config_id

# Exact HTTPS OAuth redirect URI registered in your Meta App configuration.
# For local testing, use an ngrok or secure tunnel HTTPS URL:
# e.g., https://your-tunnel-subdomain.ngrok-free.app/api/v1/instagram/callback
META_REDIRECT_URI=http://localhost:8000/api/v1/instagram/callback

# Graph API Version (Meta v26.0 recommended for Unified Login & Instagram Reels)
META_API_VERSION=v26.0
META_APP_NAME="Adoraxe Reel Automation"

# Backward compatibility fallback aliases for Direct Instagram Login (optional)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# ------------------------------------------------------------------------------
# 5. Cloudinary Storage (CDN Delivery for Instagram Containers)
# ------------------------------------------------------------------------------
# Meta requires public HTTPS URLs with byte-range support to create media containers.
# Configure your Cloudinary cloud credentials below:
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. yt-dlp Video Retrieval (Optional / Creator Content)
# ------------------------------------------------------------------------------
# Controls whether yt-dlp direct video downloading is enabled for authorized creator media.
YTDLP_ENABLED=false
YTDLP_DOWNLOAD_DIR=backend/temp
YTDLP_MAX_FILE_SIZE_MB=2048
